# Generated by matugen — DO NOT EDIT BY HAND.
#
# Apollo's hyprlock layouts reference these names instead of hardcoded colours,
# so the lock screen recolours with the wallpaper like the rest of the rice.
# Regenerated on every wallpaper change by wallpaper-switch.sh.
#
# Only core Material You roles are used here (primary/secondary/tertiary,
# surface, on_surface, on_surface_variant, outline). Alpha is the two-hex
# suffix hyprlock accepts: 4D≈0.3  66≈0.4  99≈0.6  BF≈0.75  CC≈0.8

# ── Text ────────────────────────────────────────────────────────────────
$fg         = rgb({{colors.on_surface.default.hex_stripped}})
$fg_a80     = rgba({{colors.on_surface.default.hex_stripped}}CC)
$fg_a75     = rgba({{colors.on_surface.default.hex_stripped}}BF)
$fg_a60     = rgba({{colors.on_surface.default.hex_stripped}}99)
$fg_dim     = rgb({{colors.on_surface_variant.default.hex_stripped}})
$fg_dimmer  = rgb({{colors.outline.default.hex_stripped}})

# ── Accents ─────────────────────────────────────────────────────────────
# In dark mode primary is light and on_primary is dark, which is how these
# layouts use them: a saturated pill with dark text on top.
$accent      = rgb({{colors.primary.default.hex_stripped}})
$accent_a75  = rgba({{colors.primary.default.hex_stripped}}BF)
$on_accent   = rgb({{colors.on_primary.default.hex_stripped}})
$accent_2    = rgb({{colors.tertiary.default.hex_stripped}})
$on_accent_2 = rgb({{colors.on_tertiary.default.hex_stripped}})
$accent_3    = rgb({{colors.secondary.default.hex_stripped}})

# ── Translucent cards over the wallpaper ────────────────────────────────
$surface_a30 = rgba({{colors.surface.default.hex_stripped}}4D)
$surface_a40 = rgba({{colors.surface.default.hex_stripped}}66)
$surface_a80 = rgba({{colors.surface.default.hex_stripped}}CC)

# ── Hex forms, for pango spans in placeholder_text ──────────────────────
# placeholder_text is pango markup, which wants #RRGGBB and does not
# understand rgb(). The doubled ## is hyprlang's escape for a literal #.
$fg_dim_hex      = ##{{colors.on_surface_variant.default.hex_stripped}}
$on_accent_hex   = ##{{colors.on_primary.default.hex_stripped}}
$on_accent_2_hex = ##{{colors.on_tertiary.default.hex_stripped}}

# ── Fixed ───────────────────────────────────────────────────────────────
# Shadows stay black whatever the palette; transparent is transparent.
$shadow      = rgba(00000080)
$transparent = rgba(00000000)
