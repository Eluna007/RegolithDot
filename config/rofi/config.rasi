/* rofi 2.0 renamed `modi` to `modes` (and `-modi` to `-modes` on the
 * command line). Apollo targets 2.x; on rofi 1.7 these keys are the
 * other way round. */
configuration {
    modes:                "script:~/.config/rofi/scripts/launcher.sh,drun";
    combi-modes:          "script,drun";
    combi-display-format: "{text}";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    display-script:       "";
    display-drun:         "";
}

/* The accent layer, which chains the base theme itself — this rofi only
 * honours the last @theme in a file, so they cannot be stacked.
 *
 * apollo-settings writes apollo-colors.rasi (gitignored machine state); this
 * line is committed and static. It used to rewrite this file too, with an
 * absolute /home/<user>/ path, which put a tracked modification in the way of
 * every git pull and a personal path in a tracked file. */
@theme "~/.config/rofi/themes/apollo-colors.rasi"
