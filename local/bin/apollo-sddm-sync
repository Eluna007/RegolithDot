#!/bin/bash
# Point the login screen at what the desktop is currently wearing.
#
# SDDM's greeter runs as the unprivileged `sddm` user, before any session
# exists. It cannot read anything under /home/<you> — a mode 700 home is the
# Arch default — so it cannot be pointed at your wallpaper, or at the palette
# apollo-settings generates in ~/.config. The files have to be *copied* into
# /usr/share/sddm/themes/apollo, and that needs root. This script is the only
# part of the wallpaper pipeline that does.
#
#   sudo ~/.local/bin/apollo-sddm-sync
#
# Named by its full path because sudo replaces PATH with its own `secure_path`,
# which does not include ~/.local/bin: the bare name is "command not found"
# however correctly this is installed.
#
# wallpaper-switch.sh runs it as `sudo -n` on every wallpaper change, which
# does nothing at all unless you have installed the sudoers drop-in described
# in MANUAL-INSTALL.md — a keybind has nowhere to show a password prompt, and
# a prompt with nowhere to go would hang the wallpaper change instead of
# failing it. Without the drop-in, run the command above when you want the
# login screen caught up.
#
# It refreshes an installed theme; it does not install one. That is a one-time
# `cp -r` in MANUAL-INSTALL.md, kept separate so this script has exactly one
# job and can be re-run as often as you like.
set -euo pipefail

# APOLLO_SDDM_THEME_DIR exists so scripts/test-sddm-sync.sh can drive this
# against a temporary directory. Nothing else sets it, and the same override
# is what APOLLO_ICON_DIRS does for the launcher's scanner.
THEME_DIR="${APOLLO_SDDM_THEME_DIR:-/usr/share/sddm/themes/apollo}"

die() { echo "apollo-sddm-sync: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "needs root — run: sudo ~/.local/bin/apollo-sddm-sync"
[ -d "$THEME_DIR" ] || die "$THEME_DIR does not exist; install the theme first (see MANUAL-INSTALL.md)"

# Whose desktop to follow. Under sudo that is the invoking user, not root —
# root has no wallpaper and no Apollo config, and silently syncing root's empty
# cache would blank the login screen.
user="${SUDO_USER:-$(id -un)}"
[ "$user" != "root" ] || die "run this with sudo from your own user, not as root directly"
home="$(getent passwd "$user" | cut -d: -f6)"
if [ -z "$home" ] || [ ! -d "$home" ]; then
    die "cannot find the home directory of '$user'"
fi

stage="${XDG_CACHE_HOME:-$home/.cache}/apollo/theme"
colors="$stage/sddm-colors.conf"
still_ref="$stage/still.txt"

[ -f "$colors" ] || die "no staged palette at $colors — run: apollo-settings theme"

# ── Background ───────────────────────────────────────────────────────────
# still.txt names a still image: the wallpaper itself, or the frame
# wallpaper-switch.sh pulled out of a video. The greeter cannot animate one
# and cannot read the original either way.
bg_line=""
if [ -f "$still_ref" ]; then
    still="$(cat "$still_ref")"
    if [ -f "$still" ]; then
        ext="${still##*.}"
        # Guard against a path with no dot at all, where ${still##*.} is the
        # whole filename and the copy would be named after it.
        case "$still" in
            *.*) : ;;
            *)   ext="png" ;;
        esac
        mkdir -p "$THEME_DIR/backgrounds"
        # One background at a time: without this, switching from a .png to a
        # .jpg leaves current.png behind, and theme.conf points at the new one
        # while the old one sits there forever.
        rm -f "$THEME_DIR"/backgrounds/current.*
        install -m 0644 "$still" "$THEME_DIR/backgrounds/current.$ext"
        bg_line="background=backgrounds/current.$ext"
    else
        echo "apollo-sddm-sync: $still is gone; keeping the plain background" >&2
    fi
fi

# ── theme.conf ───────────────────────────────────────────────────────────
# Written whole, atomically. A greeter reading a half-written theme.conf gets
# colours for some keys and empty strings for the rest, and an empty string is
# not a colour — it draws black.
tmp="$(mktemp "$THEME_DIR/theme.conf.XXXXXX")"
{
    echo "# Generated by apollo-sddm-sync — DO NOT EDIT BY HAND."
    echo "# Source: $colors"
    echo "[General]"
    echo "$bg_line"
    grep -v '^#' "$colors"
} > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$THEME_DIR/theme.conf"

echo "apollo-sddm-sync: updated $THEME_DIR/theme.conf${bg_line:+ and its background}"
