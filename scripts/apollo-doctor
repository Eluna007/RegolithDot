#!/usr/bin/env bash
set -u

ok_count=0
warn_count=0
fail_count=0
fail_msgs=()
warn_msgs=()

if [[ -t 1 ]]; then
  R=$'\e[0m'
  GREEN=$'\e[38;2;166;227;161m'
  YELLOW=$'\e[38;2;249;226;175m'
  RED=$'\e[38;2;243;139;168m'
  BLUE=$'\e[38;2;137;180;250m'
  DIM=$'\e[2m'
else
  R=''; GREEN=''; YELLOW=''; RED=''; BLUE=''; DIM=''
fi

ok() { ok_count=$((ok_count + 1)); printf '%s✓%s %s\n' "$GREEN" "$R" "$*"; }
warn() { warn_count=$((warn_count + 1)); warn_msgs+=("$*"); printf '%s!%s %s\n' "$YELLOW" "$R" "$*"; }
fail() { fail_count=$((fail_count + 1)); fail_msgs+=("$*"); printf '%s✗%s %s\n' "$RED" "$R" "$*"; }
info() { printf '%s::%s %s\n' "$BLUE" "$R" "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

check_cmd() {
  local cmd="$1"
  local label="${2:-$1}"
  if have "$cmd"; then ok "$label found"; else fail "$label missing"; fi
}

check_optional_cmd() {
  local cmd="$1"
  local label="${2:-$1}"
  if have "$cmd"; then ok "$label found"; else warn "$label missing"; fi
}

check_file() {
  local path="$1"
  local label="${2:-$1}"
  if [[ -f "$path" ]]; then ok "$label exists"; else fail "$label missing"; fi
}

check_dir() {
  local path="$1"
  local label="${2:-$1}"
  if [[ -d "$path" ]]; then ok "$label exists"; else fail "$label missing"; fi
}

check_optional_dir() {
  local path="$1"
  local label="${2:-$1}"
  if [[ -d "$path" ]]; then ok "$label exists"; else warn "$label missing"; fi
}

check_service() {
  local svc="$1"
  if have systemctl && systemctl is-enabled "$svc" >/dev/null 2>&1; then
    ok "$svc enabled"
  else
    warn "$svc is not enabled"
  fi
}

check_user_service() {
  local svc="$1"
  if have systemctl && systemctl --user is-active "$svc" >/dev/null 2>&1; then
    ok "$svc user service active"
  else
    warn "$svc user service not active"
  fi
}

check_font() {
  if have fc-match && fc-match "JetBrainsMono Nerd Font Mono" | grep -qi "JetBrains"; then
    ok "JetBrainsMono Nerd Font Mono available"
  else
    fail "JetBrainsMono Nerd Font Mono missing"
  fi
}

check_battery() {
  local bats=()
  shopt -s nullglob
  bats=(/sys/class/power_supply/BAT*)
  shopt -u nullglob
  if (( ${#bats[@]} > 0 )); then
    ok "battery detected (${bats[0]##*/})"
  else
    warn "no battery detected"
  fi
}

check_brightness() {
  local backs=()
  shopt -s nullglob
  backs=(/sys/class/backlight/*)
  shopt -u nullglob
  if (( ${#backs[@]} > 0 )); then
    ok "backlight detected (${backs[0]##*/})"
  else
    warn "no backlight device detected"
  fi
}

check_audio() {
  if have pactl && pactl info >/dev/null 2>&1; then
    ok "PipeWire/Pulse audio responds"
  else
    warn "audio server did not respond to pactl"
  fi
}

check_network() {
  if have nmcli && nmcli general status >/dev/null 2>&1; then
    ok "NetworkManager responds"
  else
    warn "NetworkManager did not respond"
  fi
}

check_quickshell() {
  if have quickshell; then
    ok "quickshell found"
    if quickshell list >/dev/null 2>&1; then
      ok "quickshell IPC responds"
    else
      warn "quickshell is installed but no running instance responded"
    fi
  else
    fail "quickshell missing"
  fi
}

check_aur_helper() {
  if have paru; then
    ok "AUR helper found: paru"
  elif have yay; then
    ok "AUR helper found: yay"
  else
    warn "no AUR helper found (paru/yay)"
  fi
}

# The palette, fanned out to the apps that draw beside the shell. These are
# machine state, not config: apollo-settings rewrites them on every save, and
# ~/.config/{kitty,gtk-3.0,gtk-4.0,rofi} are symlinks into the repo — so if
# they were tracked, a customised palette would sit in the way of every
# `git pull`. They are gitignored, and the committed `*.default.*` beside each
# one is the Mocha starting point.
#
# Seeding them here is what makes a fresh clone themed. It never overwrites:
# once the file exists, it belongs to whoever set the palette.
# Which wallpaper picker layout is live. Absent means the default, which is
# the normal state - this is a report, not a requirement.
check_paper_layout() {
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/apollo/paper-layout.conf"
  local now="filmstrip (default)"
  [[ -r "$f" ]] && now="$(tr -d '[:space:]' < "$f")"
  ok "wallpaper picker layout: $now"

  if [[ -x "$HOME/.local/bin/apollo-paper-layout" ]]; then
    ok "apollo-paper-layout installed"
  else
    warn "apollo-paper-layout missing from ~/.local/bin"
  fi
}

# Dynamic colours: the wallpaper drives the shell, the terminal, GTK, rofi and
# the login screen. matugen stages the colour it extracts and
# `apollo-settings theme` fans it out - both on the same wallpaper-switch.sh
# run, so a staged file with no config.json behind it means that second half
# failed.
check_dynamic_colors() {
  local stage="${XDG_CACHE_HOME:-$HOME/.cache}/apollo/theme"
  local on="off"
  if [[ -f "$HOME/.config/apollo/config.json" ]] \
     && jq -e '.dynamicColors == true' "$HOME/.config/apollo/config.json" >/dev/null 2>&1; then
    on="on"
  fi

  if [[ "$on" == "off" ]]; then
    ok "dynamic colours off (apollo-settings › Theme turns them on)"
    return
  fi

  if [[ -f "$stage/source.sh" ]]; then
    ok "dynamic colours on, wallpaper colour staged"
  else
    warn "dynamic colours on but nothing staged — switch a wallpaper (SUPER+W)"
  fi
}

# The login screen. Everything here is a *copy* under /usr/share, because the
# greeter runs as the unprivileged sddm user and cannot read $HOME at all - so
# unlike every other config in this repo, a symlink will not do and an edit in
# the repo does nothing until apollo-sddm-sync has run.
check_login_screen() {
  local theme="/usr/share/sddm/themes/apollo"

  if ! command -v sddm >/dev/null 2>&1; then
    ok "sddm not installed (logging in from a TTY is fine)"
    return
  fi

  if [[ -x "$HOME/.local/bin/apollo-sddm-sync" ]]; then
    ok "apollo-sddm-sync installed"
  else
    warn "apollo-sddm-sync missing from ~/.local/bin — the login screen cannot follow your wallpaper"
  fi

  if [[ ! -d "$theme" ]]; then
    warn "$theme missing — see MANUAL-INSTALL.md (§4.1) to install the theme"
    return
  fi
  ok "Apollo SDDM theme installed"

  # An unreadable theme file is the failure that looks like the theme simply
  # not applying: SDDM falls back to its built-in one and says nothing.
  if [[ -r "$theme/theme.conf" ]]; then
    ok "theme.conf readable"
  else
    fail "$theme/theme.conf is not world-readable — the sddm user cannot read it"
  fi

  local bg
  bg=$(sed -n 's/^background=//p' "$theme/theme.conf" 2>/dev/null)
  if [[ -z "$bg" ]]; then
    warn "the login screen has no wallpaper yet — run: sudo ~/.local/bin/apollo-sddm-sync"
  elif [[ -r "$theme/$bg" ]]; then
    ok "login screen wallpaper in place"
  else
    fail "theme.conf names $bg, which is missing or unreadable — run: sudo ~/.local/bin/apollo-sddm-sync"
  fi
}

seed_palette_files() {
  local pairs=(
    "$HOME/.config/kitty/apollo-colors.conf|$HOME/.config/kitty/apollo-colors.default.conf"
    "$HOME/.config/gtk-3.0/apollo-colors.css|$HOME/.config/gtk-3.0/apollo-colors.default.css"
    "$HOME/.config/gtk-4.0/apollo-colors.css|$HOME/.config/gtk-4.0/apollo-colors.default.css"
    "$HOME/.config/rofi/themes/apollo-colors.rasi|$HOME/.config/rofi/themes/apollo-colors.default.rasi"
  )
  local seeded=0 broken=0
  local pair live default
  for pair in "${pairs[@]}"; do
    live="${pair%%|*}"
    default="${pair##*|}"
    if [[ -f "$live" ]]; then
      continue
    fi
    if [[ ! -f "$default" ]]; then
      fail "$(basename "$default") missing — is ~/.config/$(basename "$(dirname "$default")") symlinked?"
      broken=$((broken + 1))
      continue
    fi
    if cp "$default" "$live" 2>/dev/null; then
      ok "generated $(basename "$live") from its default"
      seeded=$((seeded + 1))
    else
      fail "could not write $live"
      broken=$((broken + 1))
    fi
  done
  if (( broken > 0 )); then
    :   # already reported, and saying "present" after that would contradict it
  elif (( seeded == 0 )); then
    ok "palette files present (kitty, GTK 3/4, rofi)"
  else
    warn "seeded $seeded palette file(s) — open Apollo Settings and Apply to use your own"
  fi
}

check_wallpapers() {
  if [[ -d "$HOME/Pictures/Wallpapers" ]] && find "$HOME/Pictures/Wallpapers" -maxdepth 1 -type f | grep -q .; then
    ok "wallpapers available"
  else
    warn "no wallpapers found in ~/Pictures/Wallpapers"
  fi
  # restore-wallpaper.sh reads this on session start; without it you get a
  # bare hyprpaper instead of your last wallpaper. (Moonlit used awww and
  # ~/.cache/wallpaper-current — neither is in use here.)
  local last="$HOME/.config/hypr/last-wallpaper.txt"
  if [[ -s "$last" ]] && [[ -f "$(cat "$last")" ]]; then
    ok "last wallpaper recorded and still exists"
  elif [[ -s "$last" ]]; then
    warn "last-wallpaper.txt points at a file that no longer exists"
  else
    warn "no last-wallpaper.txt — the wallpaper will not be restored on boot"
  fi
}

# Hyprland's config is Lua. Check the entry point and its modules, and if a
# Lua compiler is installed, syntax-check them — a parse error takes the whole
# config down, and it is the one failure mode you cannot see from inside a
# broken session.
check_hypr_lua() {
  local dir="$HOME/.config/hypr"
  if [[ ! -f "$dir/hyprland.lua" ]]; then
    fail "live Hyprland config ($dir/hyprland.lua) missing"
    return
  fi
  ok "live Hyprland config exists"

  local missing=()
  local m
  for m in config env monitors appearance animations input gestures rules keybinds autostart; do
    [[ -f "$dir/lua/$m.lua" ]] || missing+=("$m.lua")
  done
  if (( ${#missing[@]} > 0 )); then
    fail "Hyprland Lua modules missing: ${missing[*]}"
  else
    ok "all Hyprland Lua modules present"
  fi

  local luac=""
  for c in luac luac5.4 luac5.3 luajit; do
    have "$c" && { luac="$c"; break; }
  done
  if [[ -z "$luac" ]]; then
    warn "no Lua compiler found — skipping config syntax check (install lua)"
    return
  fi

  local bad=()
  local f
  for f in "$dir/hyprland.lua" "$dir"/lua/*.lua; do
    [[ -f "$f" ]] || continue
    if [[ "$luac" == luajit ]]; then
      luajit -bl "$f" /dev/null >/dev/null 2>&1 || bad+=("${f#"$dir"/}")
    else
      "$luac" -p "$f" >/dev/null 2>&1 || bad+=("${f#"$dir"/}")
    fi
  done
  if (( ${#bad[@]} > 0 )); then
    fail "Lua syntax errors in: ${bad[*]}"
  else
    ok "Hyprland Lua config parses"
  fi
}

# Which hyprlock layout is active. layout.conf is gitignored machine state,
# so a fresh clone does not have one — and hyprlock with no layout sourced
# still locks, it just draws the background and nothing else. That looks like
# a broken lock screen, so it is worth naming.
check_lock_layout() {
  local dir="$HOME/.config/hyprlock"
  local active="$dir/layout.conf"

  if [[ ! -d "$dir/layouts" ]]; then
    fail "hyprlock layouts missing ($dir/layouts) — the lock screen has nothing to draw"
    return
  fi

  if [[ ! -f "$active" ]]; then
    warn "no lock screen layout set — run 'apollo-lock-layout 12' (locking now shows only the background)"
    return
  fi

  local n
  n=$(sed -n 's#.*/layouts/layout\([0-9]\+\)\.conf.*#\1#p' "$active" | head -1)
  if [[ -z "$n" ]]; then
    warn "$active exists but names no layout — run 'apollo-lock-layout 12'"
  elif [[ ! -f "$dir/layouts/layout$n.conf" ]]; then
    fail "lock screen is set to layout$n, which is not installed — run 'apollo-lock-layout' to see what is"
  else
    ok "lock screen layout: layout$n"
  fi
}

check_paths() {
  local repo="${1:-}"
  if [[ -n "$repo" && -d "$repo/.git" ]]; then
    # Any absolute /home/<user>/ path in a dotfiles repo is a bug — it only
    # works on the machine it was written on. Moonlit hardcoded a few; this
    # catches them coming back. Broadened from the original's literal
    # /home/fiw so it also catches paths added by whoever forks this.
    if git -C "$repo" grep -nE '/home/[a-z_][a-z0-9_-]*/' -- ':!README.md' ':!MANUAL-INSTALL.md' ':!.github/**' ':!scripts/apollo-doctor' ':!**/ranger_devicons/**' ':!old-apollo-shell/**' >/tmp/apollo-doctor-paths.$$ 2>/dev/null; then
      fail "repo contains hardcoded /home/<user> paths"
      sed 's/^/  /' "/tmp/apollo-doctor-paths.$$"
    else
      ok "repo has no hardcoded /home/<user> paths"
    fi
    rm -f "/tmp/apollo-doctor-paths.$$"
  fi
}

check_version() {
  local repo="${1:-}"
  if [[ -n "$repo" && -f "$repo/VERSION" ]]; then
    ok "Apollo $(cat "$repo/VERSION")"
  else
    info "pass a repo path to report the Apollo version"
  fi
}

main() {
  local repo="${1:-}"
  info "Apollo doctor"
  printf '%s\n\n' "${DIM}Pass a repo path to also check tracked files: apollo-doctor /path/to/RegolithDot${R}"

  info "Core commands"
  check_cmd hyprland Hyprland
  check_cmd quickshell Quickshell
  check_cmd rofi Rofi
  check_cmd kitty Kitty
  check_cmd thunar Thunar
  # Themed by Apollo but not required by it — a missing one costs you
  # that app's config, nothing else.
  check_optional_cmd fish Fish
  check_optional_cmd nvim Neovim

  info "Wayland desktop helpers"
  check_cmd grim grim
  check_cmd slurp slurp
  check_cmd wl-copy wl-clipboard
  # copyq, not cliphist. autostart.lua runs copyq and the bar's clipboard panel
  # queries it (scripts/clipboard.sh); cliphist is deliberately absent, and
  # this check used to demand it anyway - telling you to install a second
  # clipboard manager the shell never speaks to.
  check_cmd copyq copyq
  check_optional_cmd hyprsunset hyprsunset
  check_cmd jq jq
  # The wallpaper pipeline: hyprpaper for stills, mpvpaper+ffmpeg for
  # gifs/video, matugen for the colour scheme it derives from them.
  check_cmd hyprpaper hyprpaper
  check_cmd matugen matugen
  # The lock screen layouts all show now-playing; layout18 is mostly its
  # visualiser. Missing playerctl leaves blank widgets, not an error.
  check_cmd playerctl playerctl
  check_optional_cmd cava cava
  check_optional_cmd magick ImageMagick
  check_optional_cmd curl curl
  check_optional_cmd mpvpaper mpvpaper
  check_optional_cmd ffmpeg ffmpeg
  check_optional_cmd wofi wofi
  check_optional_cmd satty satty

  info "Hardware and services"
  check_cmd brightnessctl brightnessctl
  check_cmd rfkill rfkill
  check_cmd pactl pactl
  check_cmd nmcli NetworkManager
  # layout20's wifi widget reads nmcli (checked above, and required anyway);
  # iw is only the fallback for a machine not running NetworkManager, so its
  # absence is not worth a warning on its own.
  check_optional_cmd bluetoothctl "bluetoothctl (layout20 bluetooth widget)"
  # The bar's Tailscale widget hides itself when this is absent, so its absence
  # is informational rather than a fault.
  check_optional_cmd tailscale "tailscale (bar widget)"
  # autostart runs copyq and the bar's clipboard panel reads it. Without it the
  # panel is empty, which looks like an empty history rather than a missing tool.
  check_cmd copyq "copyq (clipboard history)"
  check_service NetworkManager
  check_service bluetooth
  check_service keyd
  check_audio
  check_network
  check_battery
  check_brightness

  info "Theme assets"
  check_font
  check_dir "$HOME/.local/share/icons/Apollo-Terminal" "Apollo-Terminal icon theme"
  check_optional_dir "$HOME/.icons/Bibata-Modern-Classic" "Bibata cursor theme"

  # hyprgrass is optional and only drives touchscreen gestures, but it used to
  # take the whole config with it when it failed to load (see lua/gestures.lua).
  # It no longer can — this reports it because after a Hyprland or kernel
  # update hyprpm needs the plugin rebuilt, and nothing else says so.
  if have hyprpm; then
    if hyprpm list 2>/dev/null | grep -qi hyprgrass; then
      ok "hyprgrass plugin loaded (touchscreen gestures)"
    else
      warn "hyprgrass not loaded — touchscreen gestures are off. After a Hyprland update: hyprpm update"
    fi
  else
    warn "hyprpm missing — touchscreen gestures need it (optional)"
  fi

  info "Apollo state"
  check_quickshell
  check_aur_helper
  check_wallpapers
  seed_palette_files
  check_file "$HOME/.config/quickshell/apollo/shell.qml" "live quickshell config"
  # The shell runs these by absolute path, as programs rather than through a
  # shell, so a lost execute bit is not an error it can report - the launcher
  # just comes up empty and the clipboard panel just stays blank.
  for s in apps battery clipboard wallpaper-thumbs; do
    if [[ -x "$HOME/.config/quickshell/apollo/scripts/$s.sh" ]]; then
      ok "$s.sh executable"
    else
      fail "$s.sh missing or not executable — the shell runs it directly"
    fi
  done
  # The two files matugen renders from the wallpaper, and the path
  # hyprlock-wallpaper.sh writes beside them. All three are regenerated in one
  # wallpaper-switch.sh run, so a missing one means that run failed: the lock
  # screen then either loses its palette or falls back to a screenshot.
  #
  # These are absent on a fresh clone until the first wallpaper change, which
  # is why they warn rather than fail.
  for f in colors.conf colors.sh wallpaper.conf; do
    if [[ -f "$HOME/.config/hyprlock/$f" ]]; then
      ok "hyprlock/$f generated"
    else
      warn "hyprlock/$f missing — switch a wallpaper (SUPER+W) to generate it"
    fi
  done
  for s in osd-report restore-wallpaper wallpaper-switch hyprlock-wallpaper; do
    if [[ -x "$HOME/.local/bin/$s.sh" ]]; then ok "$s.sh installed"; else fail "$s.sh missing from ~/.local/bin"; fi
  done

  check_dynamic_colors
  check_login_screen
  check_paper_layout
  # No .sh suffix: this one is meant to be typed.
  if [[ -x "$HOME/.local/bin/apollo-lock-layout" ]]; then
    ok "apollo-lock-layout installed"
  else
    warn "apollo-lock-layout missing from ~/.local/bin — lock screen layouts can only be switched from apollo-settings"
  fi
  check_hypr_lua
  check_lock_layout
  check_file "$HOME/.config/rofi/config.rasi" "live Rofi config"
  check_version "$repo"
  check_paths "$repo"

  printf '\n%sSummary:%s %d ok, %d warnings, %d failures\n' "$BLUE" "$R" "$ok_count" "$warn_count" "$fail_count"

  if (( fail_count > 0 )); then
    printf '%s✗ Something is wrong — %d check(s) failed.%s\n' "$RED" "$fail_count" "$R"
  elif (( warn_count > 0 )); then
    printf '%s! Mostly good — %d warning(s), nothing critical.%s\n' "$YELLOW" "$warn_count" "$R"
  else
    printf '%s✓ Everything is good — all checks passed.%s\n' "$GREEN" "$R"
  fi

  if (( fail_count > 0 || warn_count > 0 )); then
    local log="$HOME/.config/apollo/doctor.log"
    mkdir -p "$(dirname "$log")"
    {
      printf 'apollo-doctor run: %s\n' "$(date -Iseconds)"
      printf '%d ok, %d warnings, %d failures\n\n' "$ok_count" "$warn_count" "$fail_count"
      if (( fail_count > 0 )); then
        printf 'FAILURES:\n'
        printf '  - %s\n' "${fail_msgs[@]}"
        printf '\n'
      fi
      if (( warn_count > 0 )); then
        printf 'WARNINGS:\n'
        printf '  - %s\n' "${warn_msgs[@]}"
      fi
    } > "$log"
    printf '%sDetails logged to %s%s\n' "$DIM" "$log" "$R"
  fi

  if (( fail_count > 0 )); then
    exit 1
  fi
}

main "$@"
